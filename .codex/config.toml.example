# Codex MCP-Konfiguration für n8n-mcp (AI Automation Bootcamp der TCF).
# Kopieren nach ~/.codex/config.toml (global) ODER als .codex/config.toml ins Projekt
# (Projekt-Scope funktioniert nur bei "trusted projects").
# N8N_API_URL: Adresse eurer n8n in one.intelligence (steht schon da).
# N8N_API_KEY: dein eigener Schlüssel aus n8n (Einstellungen, n8n API, Create API Key, lange Laufzeit).
# N8N_MCP_ACCESS_TOKEN (optional): Ohne ihn lassen sich Workflows OHNE Webhook (also alle mit
# Zeitplan) nicht vom Agent starten. Nur falls eure n8n unter Einstellungen „Instance-level MCP“
# anbietet, dort einen Token erzeugen. Sonst die Zeile löschen.
# DISABLED_TOOLS / DISABLED_TOOL_OPERATIONS: stehen lassen. Sie sperren Löschen und Umbauen über
# den Agent, weil es dein echtes n8n-Konto ist.
# ⚠️ Die echte Datei NICHT committen (enthält deinen API-Key), sie steht in .gitignore.

[mcp_servers.n8n-mcp]
command = "npx"
args = ["-y", "n8n-mcp"]

[mcp_servers.n8n-mcp.env]
N8N_API_URL = "https://n8n.oi.destination.one"
N8N_API_KEY = "DEIN_N8N_API_KEY"
N8N_MCP_ACCESS_TOKEN = "DEIN_MCP_ACCESS_TOKEN"
MCP_MODE = "stdio"
LOG_LEVEL = "error"
DISABLE_CONSOLE_OUTPUT = "true"
DISABLED_TOOLS = "n8n_delete_workflow,n8n_update_full_workflow,n8n_manage_credentials,n8n_audit_instance,n8n_manage_agents,n8n_evaluations"
DISABLED_TOOL_OPERATIONS = "n8n_manage_folders:delete,move,rename;n8n_workflow_versions:delete,prune;n8n_executions:delete;n8n_manage_datatable:deletetable,deleterows,deletecolumn,renamecolumn,updatetable"
